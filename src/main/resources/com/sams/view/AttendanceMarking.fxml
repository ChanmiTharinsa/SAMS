<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sams.controller.AttendanceMarkingController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #b5a5c2;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Button onAction="#handleBack" text="&lt; Back" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Attendance Marking" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0" style="-fx-background-color: #af31f7;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
            </padding>

            <!-- Upper: session list -->
            <Label style="-fx-font-weight: bold;" text="Select a session to mark attendance:" />

            <TableView fx:id="sessionTable" prefHeight="200.0">
                <columns>
                    <TableColumn fx:id="colDate" prefWidth="90.0" text="Date" />
                    <TableColumn fx:id="colSubject" prefWidth="200.0" text="Subject" />
                    <TableColumn fx:id="colStart" prefWidth="70.0" text="Start" />
                    <TableColumn fx:id="colEnd" prefWidth="70.0" text="End" />
                    <TableColumn fx:id="colVenue" prefWidth="120.0" text="Venue" />
                </columns>
            </TableView>

            <!-- Lower: attendance marking table -->
            <Label fx:id="sessionInfoLabel" style="-fx-text-fill: #555555; -fx-font-weight: bold;" text="(select a session above)" />

            <TableView fx:id="attendanceTable" prefHeight="220.0">
                <columns>
                    <TableColumn fx:id="colRegNumber" prefWidth="120.0" text="Reg Number" />
                    <TableColumn fx:id="colStudentName" prefWidth="200.0" text="Student Name" />
                    <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                </columns>
            </TableView>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="8.0" style="-fx-background-color: #b5a5c2; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="12.0" />
            </padding>

            <Label fx:id="messageLabel" style="-fx-text-fill: green;" />

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button onAction="#handleSave" style="-fx-font-weight: bold;" text="Save Attendance" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
