<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefWidth="850.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sams.controller.AttendanceMarkingController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>
            <Button text="&lt; Back" onAction="#handleBack"/>
            <Label text="Attendance Marking" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <!-- Upper: session list -->
            <Label text="Select a session to mark attendance:"
                   style="-fx-font-weight: bold;"/>

            <TableView fx:id="sessionTable" prefHeight="200.0">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="90.0"/>
                    <TableColumn fx:id="colSubject" text="Subject" prefWidth="200.0"/>
                    <TableColumn fx:id="colStart" text="Start" prefWidth="70.0"/>
                    <TableColumn fx:id="colEnd" text="End" prefWidth="70.0"/>
                    <TableColumn fx:id="colVenue" text="Venue" prefWidth="120.0"/>
                </columns>
            </TableView>

            <!-- Lower: attendance marking table -->
            <Label fx:id="sessionInfoLabel" text="(select a session above)"
                   style="-fx-text-fill: #555555;"/>

            <TableView fx:id="attendanceTable" prefHeight="220.0">
                <columns>
                    <TableColumn fx:id="colRegNumber" text="Reg Number" prefWidth="120.0"/>
                    <TableColumn fx:id="colStudentName" text="Student Name" prefWidth="200.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="150.0"/>
                </columns>
            </TableView>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="8.0" style="-fx-background-color: #fafafa; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="12.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <Label fx:id="messageLabel" style="-fx-text-fill: green;"/>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Save Attendance" onAction="#handleSave"
                        style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>


