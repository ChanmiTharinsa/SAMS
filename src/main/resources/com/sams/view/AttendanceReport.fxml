<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>


<BorderPane prefWidth="950.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sams.controller.AttendanceReportController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>
            <Button text="&lt; Back" onAction="#handleBack"/>
            <Label text="Attendance Reports" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="15.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <!-- Filter panel -->
            <Label text="Filter Options:" style="-fx-font-weight: bold;"/>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="12"/>
                    <ColumnConstraints percentWidth="38"/>
                    <ColumnConstraints percentWidth="12"/>
                    <ColumnConstraints percentWidth="38"/>
                </columnConstraints>

                <Label text="Student:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="studentComboBox" maxWidth="Infinity"
                          promptText="All Students"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Subject:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="subjectComboBox" maxWidth="Infinity"
                          promptText="All Subjects"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="From Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="fromDatePicker"
                            GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="To Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <DatePicker fx:id="toDatePicker"
                            GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Generate Report" onAction="#handleGenerate"
                        style="-fx-font-weight: bold;"/>
                <Button text="Clear Filters" onAction="#handleClear"/>
            </HBox>

            <Label fx:id="filterMessageLabel" style="-fx-text-fill: red;"/>

            <!-- Results table -->
            <TableView fx:id="reportTable" prefHeight="350.0">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="90.0"/>
                    <TableColumn fx:id="colRegNumber" text="Reg No." prefWidth="90.0"/>
                    <TableColumn fx:id="colStudentName" text="Student" prefWidth="150.0"/>
                    <TableColumn fx:id="colCourse" text="Course" prefWidth="120.0"/>
                    <TableColumn fx:id="colSubject" text="Subject" prefWidth="150.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0"/>
                    <TableColumn fx:id="colLecturer" text="Lecturer" prefWidth="130.0"/>
                </columns>
            </TableView>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>
            <Label fx:id="summaryLabel" text="Generate a report to see results."
                   style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>

