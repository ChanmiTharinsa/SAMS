<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: #b1b5b5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sams.controller.AdminDashboardController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label fx:id="welcomeLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-background-color: #EBF0F5;" text="Welcome, Admin" />

    <Label style="-fx-background-color: #89aba9;" text="Admin Dashboard" />

    <Button onAction="#handleCourseManagement" style="-fx-background-color: #32a852;" text="Course Management" />

    <Button onAction="#handleStudentManagement" style="-fx-background-color: #327ba8;" text="Student Management" />

    <Button onAction="#handleLecturerManagement" style="-fx-background-color: #f1f731;" text="Lecturer Management" />

    <Button onAction="#handleClassScheduling" style="-fx-background-color: #f73531;" text="Class Scheduling" />

    <Button onAction="#handleAttendanceMarking" style="-fx-background-color: #af31f7;" text="Attendance Marking" />

    <Button onAction="#handleAttendanceReports" style="-fx-background-color: #31f7ed;" text="Attendance Reports" />

    <Button onAction="#handleLogout" style="-fx-background-color: #7f8584;" text="Logout" />

</VBox>
