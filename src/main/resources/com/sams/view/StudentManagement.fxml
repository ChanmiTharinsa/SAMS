<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>


<BorderPane prefWidth="850.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sams.controller.StudentManagementController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f4f4f4;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>
            <Button text="&lt; Back" onAction="#handleBack"/>
            <Label text="Student Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="15.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <TableView fx:id="studentTable" prefHeight="280.0">
                <columns>
                    <TableColumn fx:id="colRegNumber" text="Reg Number" prefWidth="100.0"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="110.0"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="110.0"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180.0"/>
                    <TableColumn fx:id="colCourse" text="Course" prefWidth="150.0"/>
                    <TableColumn fx:id="colYear" text="Year" prefWidth="70.0"/>
                </columns>
            </TableView>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0" style="-fx-background-color: #fafafa; -fx-border-color: #dddddd; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label fx:id="formMessageLabel" style="-fx-text-fill: red;"/>

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="15"/>
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>

                <Label text="Reg Number:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="regNumberField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Enrolled Year:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="enrolledYearField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="First Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="Course:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="courseComboBox" GridPane.rowIndex="3" GridPane.columnIndex="1"
                          GridPane.columnSpan="3" maxWidth="Infinity"/>
            </GridPane>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="addButton" text="Add Student" onAction="#handleAdd"/>
                <Button fx:id="updateButton" text="Update Selected" onAction="#handleUpdate"/>
                <Button fx:id="deleteButton" text="Delete Selected" onAction="#handleDelete"/>
                <Button fx:id="clearButton" text="Clear Form" onAction="#handleClear"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>


